# Required: Supabase Auth (the application uses the ANON_KEY variable for its public key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local HR-only demo seeding; never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_SEED_ENABLED=false

# Copy PostgreSQL connection strings from Supabase > Connect.
# DATABASE_URL: application connection; DIRECT_URL: direct/session connection for migrations.
DATABASE_URL=
DIRECT_URL=

# Optional: SePay
WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_BANK_ID=
SEPAY_BANK_DISPLAY_NAME=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=

# Optional: chatbot and image analysis
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_SERVICE_URL=http://localhost:8001
HF_API_TOKEN=
AI_CONFIDENCE_THRESHOLD=0.10

# Optional: Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Alternative: service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: notification scheduler
CRON_SECRET=

# Existing Supabase users used only for demo seeding / browser tests
E2E_ADMIN_EMAIL=
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
