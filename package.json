{
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build --webpack",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:inspect": "node scripts/inspect-db.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:skin-ai": "vitest run --config vitest.skin-ai.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead-code": "knip --exclude exports,types,nsExports,nsTypes,enumMembers,namespaceMembers,duplicates --no-config-hints",
    "duplication": "jscpd",
    "seed:knowledge-base": "node scripts/seed-knowledge-base.mjs",
    "test:timeline:static": "node scripts/test-patient-timeline.mjs --static",
    "test:timeline:route": "node scripts/test-patient-timeline.mjs --route",
    "test:timeline": "npm run lint && npm run build && node scripts/test-patient-timeline.mjs --static --route",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "googleapis": "^172.0.0",
    "groq-sdk": "^1.2.0",
    "lucide-react": "^0.511.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "postcss-load-config": "^6.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.73.1",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@prisma/client": "^7.8.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "jscpd": "^4.2.3",
    "knip": "^6.14.2",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prisma": "^7.7.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tree-node-cli": "^3.0.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
